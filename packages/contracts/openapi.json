{
  "components": {
    "schemas": {
      "AuditEventResponse": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor_type": {
            "title": "Actor Type",
            "type": "string"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "resource_type": {
            "title": "Resource Type",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "seq",
          "occurred_at",
          "actor_type",
          "actor_user_id",
          "action",
          "resource_type",
          "resource_id",
          "outcome",
          "trace_id"
        ],
        "title": "AuditEventResponse",
        "type": "object"
      },
      "CheckResult": {
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "duration_ms": {
            "default": 0,
            "title": "Duration Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CreateTenantRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "maxLength": 63,
            "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "CreateTenantRequest",
        "type": "object"
      },
      "CreateTenantResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "isolation_mode": {
            "title": "Isolation Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "isolation_mode"
        ],
        "title": "CreateTenantResponse",
        "type": "object"
      },
      "DevTokenRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "tenant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "required": [
          "email"
        ],
        "title": "DevTokenRequest",
        "type": "object"
      },
      "DevTokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "DevTokenResponse",
        "type": "object"
      },
      "GrantMembershipRequest": {
        "additionalProperties": false,
        "properties": {
          "role_code": {
            "$ref": "#/components/schemas/RoleCode"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "user_id",
          "role_code"
        ],
        "title": "GrantMembershipRequest",
        "type": "object"
      },
      "GrantMembershipResponse": {
        "properties": {
          "membership_id": {
            "format": "uuid",
            "title": "Membership Id",
            "type": "string"
          }
        },
        "required": [
          "membership_id"
        ],
        "title": "GrantMembershipResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "environment",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "principal": {
            "$ref": "#/components/schemas/PrincipalResponse"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantResponse"
          }
        },
        "required": [
          "principal",
          "tenant",
          "role",
          "capabilities"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MembershipResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role_code": {
            "title": "Role Code",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "email",
          "display_name",
          "role_code",
          "status"
        ],
        "title": "MembershipResponse",
        "type": "object"
      },
      "PrincipalResponse": {
        "properties": {
          "actor_type": {
            "title": "Actor Type",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "actor_type"
        ],
        "title": "PrincipalResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RoleCode": {
        "description": "Platform-shipped roles (ADR-010 layer 1).\n\nTenants may later compose custom roles from platform capabilities; they\nmay never introduce new capabilities, which would be tenant-specific code\nby another name (principle 1).",
        "enum": [
          "platform_admin",
          "tenant_admin",
          "data_steward",
          "executive",
          "viewer"
        ],
        "title": "RoleCode",
        "type": "string"
      },
      "TenantResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "isolation_mode": {
            "title": "Isolation Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "isolation_mode"
        ],
        "title": "TenantResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Every capability is exposed through this versioned API; the web application is one client among potential others (principle 8). No endpoint accepts SQL, a formula, or a field path from a client.",
    "summary": "Phase 1A — platform skeleton. No business intelligence functionality.",
    "title": "TriVera Executive Intelligence Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the process is running. Deliberately checks nothing else.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Verify the dependencies required to serve correct traffic.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/admin/memberships": {
      "post": {
        "description": "Grant a membership.\n\n``platform_admin`` is refused by the service: it is not a tenant role, and\npermitting it here would let a tenant-scoped principal acquire\ncross-tenant capability.",
        "operationId": "grant_membership_v1_admin_memberships_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-elevation-reason",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Elevation-Reason"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantMembershipRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantMembershipResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grant a user access to a tenant (platform staff only)",
        "tags": [
          "platform-admin"
        ]
      }
    },
    "/v1/admin/tenants": {
      "post": {
        "description": "Create a tenant and provision its analytical namespace.\n\nPhase 1A deliberately keeps this a manual, audited, platform-staff\noperation rather than self-serve. Per the Phase 0 review's answer to Q3,\nthe isolation that would be irreversible if skipped is built now;\nprovisioning *automation* waits until there is a second tenant to justify\nit.",
        "operationId": "create_tenant_v1_admin_tenants_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-elevation-reason",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Elevation-Reason"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTenantResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Provision a tenant (platform staff only)",
        "tags": [
          "platform-admin"
        ]
      }
    },
    "/v1/audit-events": {
      "get": {
        "description": "Return recent audit events for the caller's tenant.\n\nThe audit trail is a product feature, not merely an operational log — a\ntenant admin can read their own organization's governance history\n(ADR-014 §5). RLS scopes the rows; no ``tenant_id`` filter is needed and\nnone would help if the session were wrong.",
        "operationId": "list_audit_events_v1_audit_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditEventResponse"
                  },
                  "title": "Response List Audit Events V1 Audit Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List the caller's organization's audit trail",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/v1/dev/token": {
      "post": {
        "description": "Mint a token for a known user.\n\nNote that the resulting token grants nothing by itself: it merely asserts\nan identity. Whether that identity may act in the requested organization is\ndecided later, by ``resolve_context``, against the membership table.",
        "operationId": "create_dev_token_v1_dev_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "[local/ci only] Mint a development access token",
        "tags": [
          "development"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Return who the caller is and which organization they are acting in.\n\nThis is the endpoint the frontend uses to render tenant context. Note that\nit takes no input: the answer is derived entirely from the verified token\nand the membership row.",
        "operationId": "get_me_v1_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The caller's identity and tenant context",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/v1/memberships": {
      "get": {
        "operationId": "list_memberships_v1_memberships_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MembershipResponse"
                  },
                  "title": "Response List Memberships V1 Memberships Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List memberships of the caller's organization",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/v1/tenants/{tenant_id}": {
      "get": {
        "description": "Fetch a tenant named in the URL.\n\nDeliberately accepts an identifier so that the manipulation path is real\nand testable. Any id other than the caller's own tenant yields 404 — the\nsame response as a tenant that does not exist, so this endpoint cannot be\nused to discover which tenants the platform hosts (ADR-010 §4).",
        "operationId": "get_tenant_by_id_v1_tenants__tenant_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Tenant Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fetch a tenant by id (rejects any tenant but the caller's own)",
        "tags": [
          "tenancy"
        ]
      }
    }
  }
}
