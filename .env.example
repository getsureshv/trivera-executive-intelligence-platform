# TriVera EIP — local development environment template.
#
# Copy to `.env` and adjust. `.env` is git-ignored.
#
# ############################################################################
# NEVER put a real credential in this file. It is committed to source control.
# Every value here is a local-development placeholder (ADR-015, guardrail 9).
# Production credentials come from the secret manager via the SecretStore port,
# never from a committed file.
# ############################################################################

# --- environment ---------------------------------------------------------
# One of: local | ci | dev | staging | production
# The dev token issuer (/v1/dev/token) is HARD-DISABLED unless this is
# `local` or `ci`. See apps/api/src/eip/api/routers/dev_auth.py.
EIP_ENV=local
EIP_SERVICE_NAME=eip-api
EIP_LOG_LEVEL=INFO
# json | console
EIP_LOG_FORMAT=console

# --- database roles (ADR-003) --------------------------------------------
# Three distinct roles, deliberately. Do not collapse them.
#
#   eip_app       runtime. NOT owner, NOT superuser, NOT bypassrls.
#                 Row-Level Security applies to it. Startup asserts this.
#   eip_platform  the explicit privileged path. BYPASSRLS. Used ONLY by
#                 audited platform-admin operations (e.g. tenant creation).
#   eip_migrator  owns the schema and runs Alembic. Never used at runtime.
EIP_DB_APP_DSN=postgresql+asyncpg://eip_app:local_dev_only@localhost:5432/eip
EIP_DB_PLATFORM_DSN=postgresql+asyncpg://eip_platform:local_dev_only@localhost:5432/eip
EIP_DB_MIGRATOR_DSN=postgresql+asyncpg://eip_migrator:local_dev_only@localhost:5432/eip

EIP_DB_POOL_SIZE=5
EIP_DB_MAX_OVERFLOW=5
EIP_DB_ECHO=false

# --- broker (ADR-009) ----------------------------------------------------
# Redis is the Dramatiq broker. It is NOT a durable store and NOT the
# system of record for pipeline state — that lives in PostgreSQL.
#
# Published on 6380 to avoid the common collision with a pre-existing local
# Redis on 6379. Change EIP_REDIS_HOST_PORT and this URL together.
EIP_REDIS_HOST_PORT=6380
EIP_REDIS_URL=redis://localhost:6380/0

# --- api -----------------------------------------------------------------
EIP_API_HOST=0.0.0.0
EIP_API_PORT=8000
# Comma-separated. The web origin only.
EIP_CORS_ORIGINS=http://localhost:3000

# --- authentication (ADR-010) --------------------------------------------
# We are NOT an identity provider: no passwords are ever stored.
# In `local`/`ci` the API mints short-lived dev tokens with this HS256 secret.
# In every other environment token verification uses the tenant's OIDC issuer
# + JWKS and this value is ignored.
EIP_AUTH_DEV_SIGNING_SECRET=local-dev-only-not-a-real-secret-change-me
EIP_AUTH_ISSUER=https://local.eip.invalid/
EIP_AUTH_AUDIENCE=eip-api
EIP_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# Production only; leave blank locally.
EIP_AUTH_OIDC_JWKS_URL=

# --- tenant data plane (ADR-003) -----------------------------------------
# Only `schema_per_tenant` is implemented in Phase 1A. The other modes are
# declared by the TenantDataPlane port so business code cannot depend on
# schema-per-tenant assumptions.
# shared_rls | schema_per_tenant | database_per_tenant | dedicated_deployment
EIP_DATA_PLANE_MODE=schema_per_tenant
EIP_DATA_PLANE_SCHEMA_PREFIX=tenant_

# --- observability (ADR-014) ---------------------------------------------
# Off by default so no collector is required for local development.
EIP_OTEL_ENABLED=false
EIP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- worker (ADR-009) ----------------------------------------------------
EIP_WORKER_HEALTH_PORT=8001
EIP_OUTBOX_POLL_INTERVAL_SECONDS=1.0
EIP_OUTBOX_BATCH_SIZE=100

# --- web -----------------------------------------------------------------
# Server-side base URL used by the Next.js BFF route handlers.
EIP_API_BASE_URL=http://localhost:8000
